# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Generate each secret with:  openssl rand -hex 32
#
# Secrets below are left EMPTY on purpose: docker compose refuses to start (`${VAR:?}`) until
# you set them, so there is no default password that "just works" if this file is copied as-is.
# `make` and the backup scripts also read this file, so keep values free of spaces, quotes,
# `#` and `$`; hex strings from the command above are safe.

# ---- Network exposure ----
# Every published port (Directus, proxy, Postgres, MinIO, workers, llm, Ollama) binds to this
# address. Keep the default 127.0.0.1 (this machine only): Tailscale Serve on the host forwards to
# localhost, so the tailnet still reaches the stack. Set it to the host's tailnet IP
# (`tailscale ip -4`) only if clients reach the ports directly; that breaks a localhost Serve
# target and makes containers fail to start when Tailscale is not up yet. Never 0.0.0.0: these
# services are not authenticated for the open internet. Redis is never published.
D1_BIND_ADDR=127.0.0.1

# ---- PostgreSQL (the durable core) ----
POSTGRES_USER=d1
POSTGRES_PASSWORD=
POSTGRES_DB=d1_database
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
# Full DSN used by dbmate and psql migration targets.
# Replace REPLACE_WITH_POSTGRES_PASSWORD with the value of POSTGRES_PASSWORD above.
DATABASE_URL=postgres://d1:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/d1_database?sslmode=disable

# ---- Redis (job queue, Phase 4) ----
# REQUIRED. Redis is not published on the host; rq pickles jobs, so this password is what stops
# another container (or host process) from running code in the workers. Use hex so it is URL-safe
# (it is embedded in REDIS_URL):  openssl rand -hex 32
REDIS_PASSWORD=

# ---- MinIO (object storage for large files) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Surface-scan viewer (d1-surface-scan): Directus reads the rendered scans from MinIO as this dedicated user, never as the root
# user. `make bootstrap-minio` creates it (policy: s3:GetObject on <bucket>/surface-scans/* and s3:ListBucket for that prefix, nothing
# else). Set a password (openssl rand -hex 32) before running it; left empty, the user is not created and the endpoint answers 503.
MINIO_SURFACE_READER_USER=surface-reader
MINIO_SURFACE_READER_PASSWORD=

# ---- Directus (swappable adapter) ----
DIRECTUS_KEY=
DIRECTUS_SECRET=
DIRECTUS_PORT=8055
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=
# Public-facing URL for link generation (used by Directus and the proxy).
DIRECTUS_PUBLIC_URL=http://localhost
# IANA time zone for dates Directus extensions print (sample label dates in d1-report). The
# container itself runs in UTC, so without this a label made just after local midnight would
# show the previous day. Defaults to Europe/London.
D1_TIMEZONE=Europe/London
# Origins of the standalone Force App (Bearer tokens) allowed to call Directus, filter-service and diag-service cross-origin:
# the browser dev server, and (once ADR-0010 steps 3-4 are deployed) the Electron desktop app's
# app://force origin. Comma-separate, no spaces — see
# docs/superpowers/specs/2026-08-10-force-app-desktop-packaging-design.md.
FORCE_APP_ORIGIN=http://localhost:5180,app://force
# ---- STARbase (apps/starbase/web; ADR-0013, docs/runbooks/starbase.md) ----
# STARbase's exact origin: allowed with credentials by Directus, filter-service and diag-service, and
# allowed to frame the edit form. Leave empty until STARbase is deployed (nothing is added then).
STARBASE_ORIGIN=
# Where STARbase answers: report QR codes and links, the label redirects, Data Studio's links to the
# Explorer pages and the module-bar STARbase tile all go through /d1-links/go… to this address.
# REQUIRED: while it is empty every one of those permanent links answers 503. Set it on STARbase's
# first deploy (spec Q16), before the headless phase-1 migration (171).
# Invitation e-mails (d1-people-admin) land on <STARBASE_URL>/accept-invite: docker-compose.yml lists exactly that address in
# Directus's USER_INVITE_URL_ALLOW_LIST (password-reset mails land on <STARBASE_URL>/reset-password, in PASSWORD_RESET_URL_ALLOW_LIST). The mail itself needs Directus's EMAIL_* settings (docs/runbooks/a1-record-access-cutover.md).
STARBASE_URL=
# Tagged (tag:starbase) Tailscale auth key for the `starbase` device; used only by the starbase profile.
STARBASE_TS_AUTHKEY=
# d1-server's origin as STARbase calls it (Caddy's :8090 site: /config.json and the CSP).
D1_SERVER_ORIGIN=https://d1-server.tail54eeb6.ts.net
# Shared secret of the inbox crawler (scripts/inbox_crawler/): it sends it as the header X-Inbox-Crawler-Secret on
# POST /d1-inbox/auto-link, the one route that links a found file on a person's behalf. Directus's d1-inbox endpoint refuses
# that route when this is empty, shorter than 32 characters, or the header is wrong. Generate one with: openssl rand -hex 32 (64 characters)
D1_INBOX_CRAWLER_SECRET=
# Directus's session cookie is Secure: true behind HTTPS (the tailnet entry), false for plain-HTTP local use.
SESSION_COOKIE_SECURE=false
# How long the live-backup server keeps a streamed recording before purging it. This is a crash
# safety net, not an archive — the archive path is the Directus upload — so hours, not days. Raw
# captures are multi-GB, so raising this needs disk to match. See docs/force-app-operations.md.
BACKUP_RETENTION_HOURS=12

# ---- Bug-report relay (apps/force-app/bug-report-relay) ----
# Creates GitHub issues on behalf of force-app clients using a GitHub App, so no acquisition PC
# needs a GitHub credential of its own. Register the App at github.com/settings/apps (repository
# permission "Issues: Read and write" only), generate a private key, and install it on the repo
# below to get the installation ID from the resulting URL.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_BUG_REPORT_REPO=dpremoli/D1-Database
# Comma-separated GitHub logins whose "rig-test-request" label the rig will act on (ADR-0012).
# Empty = rig test requests are off. Callers of /rig-tests sign in with D1 (no shared token).
RIG_TEST_ALLOWED_LOGINS=
# Where the bug-report relay asks Directus who a rig-test caller's D1 token belongs to (same Docker network).
DIRECTUS_INTERNAL_URL=http://directus:8055
# Host path to the App's downloaded private key .pem. Bind-mounted read-only into the relay
# container rather than pasted into this file, since .env is more likely to be copied around.
GITHUB_APP_PRIVATE_KEY_FILE_HOST=./secrets/github-app-private-key.pem

# ---- Reverse proxy (Caddy, Phase 2) ----
# Port 80 routes to Directus. MinIO ports (9000/9001) are published directly. All of them bind to
# D1_BIND_ADDR (above).
PROXY_HTTP_PORT=80

# ---- Heavy-data worker (Phase 4) ----
# Static token of a machine user on the Administrator role (Directus: Settings, User Directory; the Phase 3 Operator role and
# core/apply.sh are gone, see docs/runbooks/heavy-data-pipeline.md section 1).
WORKER_DIRECTUS_TOKEN=
# MinIO bucket for uploads (must be created via `make bootstrap-minio`).
MINIO_BUCKET=d1-files
# Worker webhook port exposed on the host.
WORKER_HTTP_PORT=8080
# Peak RAM the worker may use per job when computing streaming stats (MB).
WORKER_MEMORY_LIMIT_MB=256

# Shared secret required in the X-Worker-Secret header on all webhook POSTs.
# REQUIRED: compose will not start without it, and the workers and the text-to-SQL API
# authenticate every request with it. The Directus Flow that calls the webhook must send the
# same value.
WORKER_WEBHOOK_SECRET=
# Reject presign requests larger than this many bytes (default 200 GiB).
MAX_UPLOAD_BYTES=214748364800

# ---- Analysis worker (Phase 5) ----
# Port for the FFT analysis worker webhook endpoint.
ANALYSIS_HTTP_PORT=8081

# ---- Surface-scan render worker (ADR-0021, docs/runbooks/surface-scan-worker.md) ----
# Opt-in with the archive profile (it reads the archive share, read-only):
#   docker compose --profile archive up -d surface-scan-worker
# Machine-user token for the worker; blank uses WORKER_DIRECTUS_TOKEN.
SURFACE_SCAN_DIRECTUS_TOKEN=
# Host port of the worker's webhook (container port is always 8080).
SURFACE_SCAN_HTTP_PORT=8083
# Renders at the same time: 1 (default) or 2. Each holds a whole scan in memory.
SURFACE_SCAN_CONCURRENCY=1
# Container memory cap. An out-of-memory kill takes down this container only.
SURFACE_SCAN_MEMORY_LIMIT=2g
# Seconds between polls for pending scans (the safety net behind the Flow webhook).
SURFACE_SCAN_POLL_SECONDS=60
# A render running longer than this is failed by the poller (plus 10 minutes of grace).
SURFACE_SCAN_JOB_TIMEOUT_SECONDS=3600

# ---- SMB archive (read-only file library source) ----
# The university file store behind the mapped Z: drive (Z: → \\uosfstore.shef.ac.uk\shared), mounted read-only as
# the `archive_share` volume into the archive services (archive-indexer, surface-scan-worker, inbox-crawler).
# Use an account with READ access only.
# \\uosfstore.shef.ac.uk\shared\star_group1 is a DFS link, which Docker's CIFS client cannot follow, so the volume
# mounts the link's target share directly. That share IS star_group1, so the archive root is the mount itself.
# To find a target on Windows: File Explorer → Properties of Z:\star_group1 → DFS tab.
SMB_HOST=cl3-researchdata01-c5.shef.ac.uk
# Single quotes keep the `$` of the hidden share literal.
SMB_SHARE='star_group1$'
SMB_USER=
SMB_PASS=
# AD domain if required. Leave blank for none.
SMB_DOMAIN=shefuniad
# Where star_group1 sits inside the containers: the mount itself here. The compose default,
# /mnt/archive/star_group1, fits a mount of the whole `shared` share (a share that is not DFS).
ARCHIVE_CONTAINER_ROOT=/mnt/archive
# Populate the Directus File Library from the archive (idempotent — safe to re-run,
# good as a nightly cron). Indexes the star_group1 subtree, link-worthy extensions
# only (matlab / word / pdf / excel / csv / tiff / ebsd):
#   make index-archive
# Or on the host against the mapped drive:
#   DATABASE_URL=... ARCHIVE_ROOT='Z:\star_group1' python scripts/index_archive.py

# ---- Inbox crawler (found files and the Inbox) ----
# `make inbox-crawler` starts a read-only daemon (compose profile `archive`, the same archive_share mount as above)
# that watches Users/<uni alias> and Shared/<share folder> and offers new files in STARbase's Inbox. See
# docs/runbooks/inbox-crawler.md. It reads the share through the SMB account above, which today can write
# (known risk, ADR-0020): a read-only account is a follow-up.
# Where the d1-inbox endpoint is, for auto-link calls (the crawler sends D1_INBOX_CRAWLER_SECRET as
# X-Inbox-Crawler-Secret). The default is the Directus container on the compose network.
D1_INBOX_URL=http://directus:8055
# Inbox crawler tuning, both optional: OCR of the SEM data bar (off unless set to 1; needs pytesseract and tesseract in the
# image, which it does not install, and a validation on real JEOL images first: physical test IF8) and the log level
# (INFO by default; DEBUG logs every file opened). Empty keeps the defaults.
INBOX_OCR=
INBOX_LOG_LEVEL=
# The top-level folder of the personal folders on the share. Empty keeps compose's default, `User`, which is how
# the lab share spells it (Z:\star_group1\User).
INBOX_PERSON_DIR=
# Trial runs: scan only these comma-separated folder names (uni aliases or team share folders), e.g. mtp21dp.
# Everyone else's folder is skipped, as a Former person's is. Empty scans everyone who has a folder.
INBOX_ONLY_FOLDERS=
# The shared secret itself, D1_INBOX_CRAWLER_SECRET, is defined with the Directus settings above (at least 32
# characters; empty switches auto-link off, and the crawler still finds files for people to link by hand).

# ---- Phase 8: Legacy data migration ----
# Run once after the stack is up and all migrations are applied:
#   make migrate-legacy XLSX=/path/to/Sample_Data.xlsx
# Idempotent (ON CONFLICT DO NOTHING) — safe to re-run.
# No extra env vars needed beyond DATABASE_URL above.

# ---- Text-to-SQL + local LLM (Phase 6) ----
# The llm-text-to-sql plugin now runs by default (the Directus "Ask the Database"
# chat page proxies to it). The containerised `ollama` service is still opt-in via
# the "llm" profile — but by default the plugin points at your HOST Ollama below.
# Host port for the text-to-SQL API (direct curl / eval; the chat page does not
# need it, it reaches the plugin over the internal network).
LLM_HTTP_PORT=8082
# Ollama runtime URL used by the plugin. Default targets the Ollama already
# running on the host. Use http://ollama:11434 to use the containerised one
# instead (docker compose --profile llm up -d ollama).
OLLAMA_URL=http://host.docker.internal:11434
# Ollama container's host port (only used with the "llm" profile container).
OLLAMA_PORT=11434
# Models served by Ollama (pull them once — see the runbook). For SQL quality a
# code-capable model beats llama3, e.g. qwen2.5-coder or llama3.1.
OLLAMA_SQL_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text
# Where the Directus d1-ask-endpoint proxy reaches the plugin (internal network).
LLM_PLUGIN_URL=http://llm-text-to-sql:8080
# Per-query statement timeout enforced by the plugin (milliseconds).
LLM_STATEMENT_TIMEOUT_MS=5000
# Read-only DSN: a LOGIN role that inherits d1_llm_readonly. Create it once after
# migrations (see docs/runbooks/text-to-sql.md), then set it. NEVER point this at the
# superuser. Host is `postgres` inside the compose network. Left EMPTY on purpose: the
# text-to-SQL API stays disabled until you set it. Format:
#   postgres://d1_llm_app:<hex password>@postgres:5432/d1_database?sslmode=disable
LLM_DATABASE_URL=
# Writer DSN used ONLY by the embedding backfill (writes semantic_embeddings). It must be a
# dedicated NON-superuser role, never `d1`: this container also runs LLM-authored SQL. Create
# `d1_embedder` once as the superuser (runbook docs/runbooks/text-to-sql.md section 1):
#   CREATE ROLE d1_embedder LOGIN PASSWORD '<hex>';
#   GRANT CONNECT ON DATABASE d1_database TO d1_embedder;
#   GRANT USAGE ON SCHEMA public TO d1_embedder;
#   GRANT SELECT ON v_embeddings_source_notes TO d1_embedder;
#   GRANT SELECT, INSERT, UPDATE ON semantic_embeddings TO d1_embedder;
# Left EMPTY on purpose: until the role exists the backfill is simply disabled. Format:
#   postgres://d1_embedder:<hex password>@postgres:5432/d1_database?sslmode=disable
EMBED_DATABASE_URL=
