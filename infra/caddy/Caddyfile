# D1-Database — Caddy reverse proxy (local dev / single-host).
#
# Routes HTTP traffic on port 80 to the Directus admin UI.
# MinIO API (9000) and console (9001) are accessed directly on their own ports.
# For TLS in production, replace ":80" with your domain name — Caddy will
# automatically provision a Let's Encrypt certificate.
:80 {
    # Potree octrees (Phase 2): served same-origin so Directus's CSP (connect-src
    # 'self') allows the browser to stream them. handle_path strips the /octrees
    # prefix, mapping /octrees/<op>/octree.bin -> /srv/octrees/<op>/octree.bin.
    # file_server supports HTTP range reads, which potree-core relies on.
    handle_path /octrees/* {
        root * /srv/octrees
        # CORS for the standalone Force App (cross-origin, network-trusted — no auth on the
        # octree bytes). ACAO "*" (no credentials are sent). Potree streams nodes with a Range
        # header, which is NOT CORS-safelisted, so the browser fires an OPTIONS preflight that
        # must be answered, and the range/length response headers must be EXPOSED for the LOD
        # loader to read them.
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
        header Access-Control-Allow-Headers "Range, If-None-Match, Content-Type"
        header Access-Control-Expose-Headers "Accept-Ranges, Content-Range, Content-Length, Content-Encoding, ETag"
        # Revalidate on every request (conditional GET via ETag). Without this Caddy sends
        # only ETag/Last-Modified, so browsers apply HEURISTIC freshness and can keep
        # serving a stale metadata.json / octree.bin cached from BEFORE a rebuild — which
        # showed as wrong octree colour limits after the climits repatch. "no-cache" still
        # allows caching but forces a 304 check, so unchanged files stay cheap.
        header Cache-Control "no-cache"
        # Short-circuit the CORS preflight (the headers above are already applied).
        @preflight method OPTIONS
        respond @preflight 204
        file_server
    }
    # FRM filter-service (interactive signal-filter previews). Same-origin so the
    # dashboard can call it under Directus's CSP; the service forwards the caller's
    # Directus credentials when fetching the live cache, so auth stays Directus's.
    handle_path /filter/* {
        reverse_proxy filter-service:8000
    }
    # diag-service (interactive diagnostics-recipe previews). Same-origin so the workbench can
    # call it under Directus's CSP; the service forwards the caller's Directus credentials when
    # resolving the analysis row, so authz stays Directus's. handle_path strips /diag, mapping
    # /diag/preview → /preview (the service routes are /health and /preview in-container).
    handle_path /diag/* {
        reverse_proxy diag-service:8000
    }
    # Recording backend (FastAPI on the acquisition host, needs the DAQ hardware so it is NOT a
    # container). Proxied same-origin at /recorder → host.docker.internal:8200, so the SPA's REST
    # calls AND the /record/stream WebSocket reach it without CORS or HTTPS mixed-content blocks
    # (http/ws://localhost from an https page is refused by browsers). handle_path strips /recorder,
    # mapping /recorder/record/start → /record/start. reverse_proxy upgrades the WebSocket
    # transparently. Only the host actually running the recorder answers; the tailnet is trusted.
    # The recorder refuses this route by default (loopback-only Host check, docs/force-app-operations.md);
    # it needs RECORDER_ALLOWED_HOSTS and RECORDER_CORS_ORIGINS set on the recorder to work.
    handle_path /recorder/* {
        reverse_proxy host.docker.internal:8200
    }
    # force-app live recording backup (apps/force-app/backup-server). The acquisition PC streams
    # raw D1RW chunks here while recording, and pulls them back to finalize if the local copy is
    # lost. Proxied same-origin so it rides the one TLS entry point instead of publishing a second
    # plaintext port; handle_path strips the prefix, mapping /backup-ingest/ingest/chunk →
    # /ingest/chunk. Chunk uploads are up to 4 MB (backup.py's MAX_CHUNK_BYTES) and raw downloads
    # are multi-GB; Caddy streams both without a size limit unless one is configured, so no
    # request_body directive is wanted here.
    #
    # NOTE: the backup server has NO authentication of its own — anyone who can reach this route
    # can read or delete any stored capture. That is the same tailnet-trust posture as /recorder
    # and /octrees above (this Caddy is reachable only over Tailscale), and it is why the service
    # must stay unpublished in docker-compose rather than exposed on :8210 directly. Revisit if
    # this host ever becomes publicly reachable.
    handle_path /backup-ingest/* {
        reverse_proxy backup-server:8210
    }
    # Bug-report relay (apps/force-app/bug-report-relay). Holds the GitHub App private key
    # centrally so force-app clients never carry a GitHub credential of their own; the backend on
    # each acquisition PC POSTs here instead of calling api.github.com directly. handle_path strips
    # the prefix, mapping /bug-report-relay/report -> /report.
    #
    # NOTE: like /backup-ingest above, this relay has NO authentication of its own — anyone who can
    # reach this route can file issues on the configured repo as the GitHub App. Same tailnet-trust
    # posture (this Caddy is reachable only over Tailscale); must stay unpublished in docker-compose
    # rather than exposed directly.
    handle_path /bug-report-relay/* {
        reverse_proxy bug-report-relay:8211
    }
    # Electron auto-update feed (electron-updater, generic provider). Populated by a pull-based
    # publish script run on this host (apps/force-app/desktop/scripts/publish-release.ps1) — see
    # docs/superpowers/specs/2026-08-10-force-app-desktop-packaging-design.md. Tailnet-only by
    # construction: this Caddy instance is reachable only over Tailscale, and the app ships
    # unsigned, so the update channel's trust rests entirely on this transport staying private.
    handle_path /force-app-updates/* {
        root * /srv/force-app-updates
        file_server
    }
    # Standalone Force App SPA (built with base /app/). Served same-origin as Directus so it
    # calls /items,/assets,/auth (Directus), /filter and /octrees without CORS — reachable over
    # Tailscale at https://<node>.<tailnet>.ts.net/app/. SPA history fallback → index.html.
    handle_path /app/* {
        root * /srv/force-app
        try_files {path} /index.html
        # index.html must revalidate so a rebuild is picked up; the hashed assets are immutable.
        @html path / *.html
        header @html Cache-Control "no-cache"
        file_server
    }
    reverse_proxy directus:8055
}
