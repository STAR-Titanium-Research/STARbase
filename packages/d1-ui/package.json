{
  "name": "@d1/ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shared UI kit for the D1 Explorer pages (record routes, status vocabularies, components, composables). Consumed from source by the Directus extensions; no build step.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./recordRoute": "./src/recordRoute.ts",
    "./choiceLabels": "./src/choiceLabels.ts",
    "./editDrawer": "./src/editDrawer.ts",
    "./editFrame": "./src/editFrame.ts",
    "./editSession": "./src/composables/useEditSession.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "vue": "^3.5.43",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@xmldom/xmldom": "^0.9.12",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
