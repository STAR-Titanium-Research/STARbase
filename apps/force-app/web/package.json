{
  "name": "force-app-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone force-analysis app (Phase 1: plotting extracted off the Directus admin module).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:desktop": "vite build --mode desktop --outDir dist-desktop",
    "preview": "vite preview",
