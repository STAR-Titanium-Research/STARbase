    "material-symbols": "^0.48.0",
    "potree-core": "^2.0.4",
    "three": "^0.186.1",
    "vue": "^3.5.43",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
