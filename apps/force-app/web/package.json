    "test": "vitest run --passWithNoTests",
    "lint:theme": "node scripts/check-theme-colors.mjs"
  },
  "dependencies": {
    "@d1/force-plotting": "*",
    "axios": "^1.7.9",
    "grid-layout-plus": "^1.1.1",
    "material-symbols": "^0.47.5",
    "potree-core": "^2.0.4",
    "three": "^0.160.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/three": "^0.160.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  }
}
