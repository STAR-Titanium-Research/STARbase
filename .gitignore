# ---- Secrets & local config ----
.env
.env.*
!.env.example
*.key
*.pem
secrets/
*.local

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
# Bare `dist/` matches only directories named exactly "dist" — the desktop-base SPA build output
# needs its own entry.
apps/force-app/web/dist-desktop/
apps/force-app/desktop/release/
# electron-builder's buildResources convention is a directory named "build" — collides with the
# generic build/ ignore above, but this one holds tracked source assets (the app icon), not
# generated output. Un-ignoring the directory itself is required before per-file negation applies.
!apps/force-app/desktop/build/
!apps/force-app/desktop/build/icon.*
# Playwright smoke-test output (traces, screenshots, error-context.md on failure)
apps/force-app/desktop/test-results/
apps/force-app/web/test-results/

# ---- Node / front-end ----
node_modules/
.npm/
.pnpm-store/
*.tsbuildinfo
.next/
dist-ssr/

# ---- Docker / data volumes ----
# Never commit database, object-storage, or cache state.
data/
pgdata/
minio-data/
redis-data/
*.dump
*.sql.gz

# ---- Large experimental data (belongs in MinIO, never git) ----
*.h5
*.hdf5
*.bin
*.mat
*.tdms
force-files/

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json

# ---- Build / tooling output ----
*.log
.cache/
tmp/
infra/octrees
infra/force-app-updates

# ---- Local / not-for-repo ----
# local Claude config, memory, plans — but project skills, agents, agent memory, hooks and
# the shared settings.json are checked in (settings.local.json, logs and state stay local)
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/agent-memory/
!.claude/hooks/
!.claude/settings.json
# per-machine skill setup (see each skill's config.example.json)
.claude/skills/*/config.json
# local dev override (temporary SMB-mount workaround)
docker-compose.override.yml
# TLS certs (e.g. the Tailscale serve cert)
*.crt
# example log sheets / trace CSVs — belong in MinIO, not git
FAST Data/
# scratch reference dumps
for llm *
# verification screenshots
tests/ui/*.png
# ad-hoc Playwright verification artifacts (screenshots, console logs) from agent testing sessions
.playwright-mcp/
/screenshots/

# Local daemon logs (force/fast orchestrators)
logs/

# Superpowers brainstorming visual-companion artifacts
.superpowers/

# npm workspace root
/node_modules/
# Vite dev cache
apps/force-app/web/.vite/
_shots*.mjs
