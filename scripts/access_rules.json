    "xrd_params": ["create", "read", "update", "delete"],
    "materials": ["create", "read", "update", "delete"],
    "material_iso_classifications": ["create", "read", "update", "delete"],
    "alloying_elements": ["create", "read", "update", "delete"],
    "material_alloying_elements": ["create", "read", "update", "delete"],
    "equipment": ["create", "read", "update", "delete"],
    "tools": ["create", "read", "update", "delete"],
    "tool_boxes": ["create", "read", "update", "delete"],
    "cutting_inserts": ["create", "read", "update", "delete"],
    "insert_edges": ["create", "read", "update", "delete"],
    "insert_types": ["create", "read", "update", "delete"],
